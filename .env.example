# Conexão com o SQL Server para preenchimento automático dos dados do
# transformador. Copie para .env e preencha. O .env NÃO vai para o Git
# (ver .gitignore) e é embutido no .exe pelo electron-builder no build.
#
# Sem este arquivo o app funciona normalmente, apenas em modo manual.

# Aceita "HOST" ou "HOST\INSTÂNCIA". Com instância nomeada o DB_PORT é
# IGNORADO: no tedious, port e instanceName são mutuamente exclusivos, e a
# resolução passa a depender do SQL Browser (UDP 1434) estar alcançável.
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Usado somente quando DB_SERVER não traz instância nomeada.
DB_PORT=1433

# Servidor on-premise costuma ter certificado autoassinado. Com
# DB_ENCRYPT=true e DB_TRUST_CERT=false a conexão falha no handshake, com
# mensagem pouco óbvia. Na dúvida, comece com DB_TRUST_CERT=true.
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Versão mínima de TLS. Vazio = padrão do Node (TLSv1.2).
# SQL Server antigo que só fala TLS 1.0/1.1 derruba a conexão com
# "SSL routines:OPENSSL_internal:UNSUPPORTED_PROTOCOL" — inclusive com
# DB_ENCRYPT=false, porque o pacote de login é sempre criptografado.
# Nesse caso use TLSv1. Contorno para servidor obsoleto: o conserto de
# verdade é habilitar TLS 1.2 no servidor.
DB_TLS_MIN=

# A query NÃO fica aqui: vive em query/query_dadosTransformador.txt, fora do
# Git e embutida no .exe pelo build. Ver query/README.example.md.
